{
  "name": "wikids",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:foundation": "vitest run tests/foundation",
    "verify:test-foundation": "node scripts/verify-test-foundation.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "user:create": "node scripts/create-user.mjs",
    "user:create:docker": "docker compose run --rm --no-deps --entrypoint node -v \"$PWD:/repo\" -w /repo web scripts/create-user.mjs",
    "verify:security-baseline": "node scripts/verify-security-baseline.mjs",
    "verify:engine": "node scripts/verify-engine.mjs",
    "verify:domain-security": "node scripts/verify-domain-security.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify:ai-contract": "node scripts/verify-ai-contract.mjs"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.0",
    "@types/mdx": "^2.0.13",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "fast-check": "^4.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
