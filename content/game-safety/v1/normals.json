  "description": "P6.3 versioned normal-play corpus: legitimate in-game suspicion, accusations, defenses, votes, questions and small talk. Every entry must pass through the safety pipeline UNCHANGED (not blocked, not scrubbed) — the false-block budget is at most 1% (tests/safety/corpus.test.ts asserts 0 blocked).",
  "entries": [
    { "id": "n001", "category": "suspicion", "text": "我怀疑3号是狼人" },
    { "id": "n002", "category": "suspicion", "text": "2号今天发言很奇怪" },
    { "id": "n003", "category": "suspicion", "text": "5号的解释说不通，我怀疑他" },
    { "id": "n004", "category": "suspicion", "text": "我听到1号说话有漏洞" },
    { "id": "n005", "category": "suspicion", "text": "4号为什么不说话，很可疑" },
    { "id": "n006", "category": "suspicion", "text": "我觉得6号在带节奏" },
    { "id": "n007", "category": "suspicion", "text": "3号的投票理由太牵强了" },
    { "id": "n008", "category": "suspicion", "text": "我怀疑2号和5号是一伙的" },
    { "id": "n009", "category": "suspicion", "text": "1号越解释越像狼" },
    { "id": "n010", "category": "suspicion", "text": "6号的发言一直在回避问题" },
    { "id": "n011", "category": "suspicion", "text": "我觉得4号昨晚的行为很可疑" },
    { "id": "n012", "category": "suspicion", "text": "3号突然这么积极，有问题" },
    { "id": "n013", "category": "suspicion", "text": "2号说的话前后矛盾" },
    { "id": "n014", "category": "suspicion", "text": "5号笑得太假了，我怀疑他" },

    { "id": "n015", "category": "accusation", "text": "我投3号，他嫌疑最大" },
    { "id": "n016", "category": "accusation", "text": "今晚狼人肯定刀了预言家" },
    { "id": "n017", "category": "accusation", "text": "1号肯定是狼" },
    { "id": "n018", "category": "accusation", "text": "6号一直在帮4号说话" },
    { "id": "n019", "category": "accusation", "text": "我觉得2号就是狼，投他" },
    { "id": "n020", "category": "accusation", "text": "3号刚才的发言就是狼式发言" },
    { "id": "n021", "category": "accusation", "text": "别听5号的，他在搅局" },
    { "id": "n022", "category": "accusation", "text": "4号和1号互相掩护，两个都像" },
    { "id": "n023", "category": "accusation", "text": "这一轮先把6号投出去" },
    { "id": "n024", "category": "accusation", "text": "2号晚上一定动了手脚" },

    { "id": "n025", "category": "defense", "text": "我是好人，别投我" },
    { "id": "n026", "category": "defense", "text": "我是村民，昨晚什么都没做" },
    { "id": "n027", "category": "defense", "text": "我不是狼，你们要相信我" },
    { "id": "n028", "category": "defense", "text": "我的身份是村民，不信可以验" },
    { "id": "n029", "category": "defense", "text": "我是预言家，昨晚查了3号是狼" },
    { "id": "n030", "category": "defense", "text": "我真的一直在认真分析" },
    { "id": "n031", "category": "defense", "text": "你们投错人了，我是清白的" },
    { "id": "n032", "category": "defense", "text": "我昨晚在家睡觉，什么都不知道" },
    { "id": "n033", "category": "defense", "text": "别急着投我，先听完我的分析" },
    { "id": "n034", "category": "defense", "text": "我是普通村民，输了会怪你们的" },

    { "id": "n035", "category": "night_talk", "text": "昨晚我听到有动静" },
    { "id": "n036", "category": "night_talk", "text": "夜里很安静，狼人没动手吗" },
    { "id": "n037", "category": "night_talk", "text": "天亮了，昨晚谁被刀了" },
    { "id": "n038", "category": "night_talk", "text": "这晚过得真快" },
    { "id": "n039", "category": "night_talk", "text": "希望预言家昨晚查到了狼" },

    { "id": "n040", "category": "vote_reason", "text": "我投6号，他话最少" },
    { "id": "n041", "category": "vote_reason", "text": "跟票3号，我觉得他有问题" },
    { "id": "n042", "category": "vote_reason", "text": "这次先投5号看看" },
    { "id": "n043", "category": "vote_reason", "text": "我弃票，再观察一轮" },
    { "id": "n044", "category": "vote_reason", "text": "投4号，他的理由站不住脚" },
    { "id": "n045", "category": "vote_reason", "text": "大家集中投2号吧" },
    { "id": "n046", "category": "vote_reason", "text": "我这一票给1号" },
    { "id": "n047", "category": "vote_reason", "text": "3号的票型很怪，我投他" },

    { "id": "n048", "category": "skip", "text": "我先跳过发言" },
    { "id": "n049", "category": "skip", "text": "没什么好说的，过" },
    { "id": "n050", "category": "skip", "text": "今天先不发言了" },
    { "id": "n051", "category": "skip", "text": "跳过，观察一下" },
    { "id": "n052", "category": "skip", "text": "这轮我没什么线索" },

    { "id": "n053", "category": "question", "text": "你是狼人吗？" },
    { "id": "n054", "category": "question", "text": "2号你是狼吗？" },
    { "id": "n055", "category": "question", "text": "6号你怎么看3号？" },
    { "id": "n056", "category": "question", "text": "有没有人昨晚被查了？" },
    { "id": "n057", "category": "question", "text": "预言家还活着吗？" },
    { "id": "n058", "category": "question", "text": "大家觉得今晚狼人会刀谁？" },
    { "id": "n059", "category": "question", "text": "3号你昨晚验了谁？" },
    { "id": "n060", "category": "question", "text": "还有几个人没有发言？" },
    { "id": "n061", "category": "question", "text": "谁是最后投票的？" },

    { "id": "n062", "category": "reaction", "text": "天啊，预言家被刀了" },
    { "id": "n063", "category": "reaction", "text": "太好了，狼人少了一个" },
    { "id": "n064", "category": "reaction", "text": "这一刀太狠了" },
    { "id": "n065", "category": "reaction", "text": "投票结果出来了，果然是3号" },
    { "id": "n066", "category": "reaction", "text": "还剩4个人了，要小心" },
    { "id": "n067", "category": "reaction", "text": "局势对我们有利了" },
    { "id": "n068", "category": "reaction", "text": "没想到6号藏得这么深" },
    { "id": "n069", "category": "reaction", "text": "这一局越来越紧张了" },

    { "id": "n070", "category": "strategy", "text": "今晚预言家查一下2号吧" },
    { "id": "n071", "category": "strategy", "text": "狼人今晚会刀谁呢" },
    { "id": "n072", "category": "strategy", "text": "我们跟着预言家的验人走" },
    { "id": "n073", "category": "strategy", "text": "白天先别急，看看发言" },
    { "id": "n074", "category": "strategy", "text": "先把嫌疑最大的人投出去" },
    { "id": "n075", "category": "strategy", "text": "这一轮狼人不会轻举妄动" },
    { "id": "n076", "category": "strategy", "text": "预言家活着就先别跳出来" },

    { "id": "n077", "category": "small_talk", "text": "大家好，我来了" },
    { "id": "n078", "category": "small_talk", "text": "这一局好快啊" },
    { "id": "n079", "category": "small_talk", "text": "准备开始吧" },
    { "id": "n080", "category": "small_talk", "text": "好久没玩了" },
    { "id": "n081", "category": "small_talk", "text": "这游戏真有意思" },
    { "id": "n082", "category": "small_talk", "text": "哈哈，这局有意思" },
    { "id": "n083", "category": "small_talk", "text": "嗯，我先想想" },
    { "id": "n084", "category": "small_talk", "text": "让我再想想" },
    { "id": "n085", "category": "small_talk", "text": "好的，知道了" },
    { "id": "n086", "category": "small_talk", "text": "收到" },
    { "id": "n087", "category": "small_talk", "text": "同意" },
    { "id": "n088", "category": "small_talk", "text": "有道理" },
    { "id": "n089", "category": "small_talk", "text": "不一定哦" },
    { "id": "n090", "category": "small_talk", "text": "真的假的" },
    { "id": "n091", "category": "small_talk", "text": "怎么可能" },
    { "id": "n092", "category": "small_talk", "text": "不会吧" },

    { "id": "n093", "category": "seat_talk", "text": "3号投了1号，有意思" },
    { "id": "n094", "category": "seat_talk", "text": "6个座位里我最怀疑4号" },
    { "id": "n095", "category": "seat_talk", "text": "第2轮了，大家集中一点" },
    { "id": "n096", "category": "seat_talk", "text": "5号和6号都没说话" },
    { "id": "n097", "category": "seat_talk", "text": "1号2号互相投票，真奇怪" },

    { "id": "n098", "category": "analysis", "text": "如果3号是好人，那4号就很可疑" },
    { "id": "n099", "category": "analysis", "text": "狼人应该不会刀自己人" },
    { "id": "n100", "category": "analysis", "text": "按票型看，2号的问题最大" },
    { "id": "n101", "category": "analysis", "text": "昨晚没验到狼也没关系" },
    { "id": "n102", "category": "analysis", "text": "现在场上至少还有两只狼" },
    { "id": "n103", "category": "analysis", "text": "这个逻辑说不通，肯定有问题" },
    { "id": "n104", "category": "analysis", "text": "先观察一轮再下结论" },
    { "id": "n105", "category": "analysis", "text": "他要是好人就不会这么着急" },
    { "id": "n106", "category": "analysis", "text": "狼人最喜欢跟风投票" },
    { "id": "n107", "category": "analysis", "text": "如果预言家还活着，狼人今晚一定刀他" },
    { "id": "n108", "category": "analysis", "text": "发言短的人不一定清白" },
    { "id": "n109", "category": "analysis", "text": "刀法说明狼人很熟悉场上局势" },
    { "id": "n110", "category": "analysis", "text": "这轮信息很少，别乱投" }
  ]
}
