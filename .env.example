# Copy this to `.env` (used by both `npm run dev` and `docker compose`).
# Next.js auto-loads `.env`; docker-compose reads it for variable substitution.

# Postgres connection string. The default value works for `npm run dev`
# (talks to the docker-compose Postgres on the host's published port).
# When the web service runs inside docker-compose, this is overridden to
# `postgres://postgres:postgres@db:5432/wikids` so it uses the compose network.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wikids

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Public URL where the app is served. Used by Auth.js for callback URLs.
AUTH_URL=http://localhost:3000

# --- AI provider (P3.3, server-only) ---
# DeepSeek Responses API credentials for the product AI turns. Never reuse
# any other provider credential (e.g. the Orbit task-runner's) here — the
# provider reads exactly these server-side names and nothing else.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Per-attempt timeout in ms. P6.3 frozen default: 10000 (10s per decision;
# timeouts are never retried).
DEEPSEEK_TIMEOUT_MS=10000
# max_output_tokens. P6.3 frozen default: 256 (hard cap, clamped).
DEEPSEEK_MAX_OUTPUT_TOKENS=256
# Server secret for the irreversible game-seat HMAC used as the anonymous
# provider `user` id — names, emails and raw game/seat ids are never sent.
# Generate with: openssl rand -base64 32
GAME_SEAT_HMAC_SECRET=

# --- AI orchestration (P4.1/P6.3, server-only) ---
# P6.3 emergency switch: "0"/"false" turns the provider off entirely
# (every AI decision falls back deterministically and games still run to
# completion). Unset = enabled iff DEEPSEEK_API_KEY is configured; a
# missing key also disables the provider without error. The P4.1 name
# GAME_AI_ENABLED is still accepted as an alias.
AI_PROVIDER_ENABLED=
# REQUIRED global daily provider-attempt budget (process-wide, calendar
# day UTC). Safe default 10000 applies when unset; an INVALID value
# disables the provider (fail-safe degrade to the deterministic fallback).
GAME_AI_GLOBAL_DAILY_CAP=10000

# --- Game API layer (P5.1, server-only) ---
# User-level rate limits for the /api/games/sessions handlers (60s sliding
# windows, in-process). 429 is ONLY used for these and for the per-session
# concurrent-advance limit; provider failures never surface as 429/5xx.
GAME_RATE_CREATE_PER_MINUTE=10
GAME_RATE_ACTION_PER_MINUTE=120
# Hard cap on a JSON request body to the game API, bytes (default 16384).
GAME_API_MAX_BODY_BYTES=16384
